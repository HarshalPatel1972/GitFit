# Secret used to encrypt session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App (https://github.com/settings/developers)
#   Homepage URL: http://localhost:3000
#   Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Production only: your public URL (custom domain), used for SEO and social previews.
# NEXT_PUBLIC_SITE_URL=https://gitfit.example.com

# Self-hosting outside Vercel: trust the Host header behind your proxy
# AUTH_TRUST_HOST=true
